/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: #49b1f5 #5bc0ff
  --accent: #ff7242 #ff8555
  --page-bg: #f5f5f5 #1a1a2e
  --card-bg: #ffffff #1e1e38
  --card-bg-transparent: rgba(255, 255, 255, 0.85) rgba(30, 30, 56, 0.85)

  --btn-content: #49b1f5 #5bc0ff

  --btn-regular-bg: #e8f4fd #2a2a4a
  --btn-regular-bg-hover: #d4ecfa #35355a
  --btn-regular-bg-active: #bfe3f7 #40406a

  --btn-plain-bg-hover: #e8f4fd #2a2a4a
  --btn-plain-bg-active: #d4ecfa #35355a

  --btn-card-bg-hover: #f0f7fe #2a2a4a
  --btn-card-bg-active: #e0eef9 #35355a

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #1f2d3d #e0e0e0

  --title-active: #49b1f5 #5bc0ff

  --line-divider: rgba(0, 0, 0, 0.08) rgba(255, 255, 255, 0.08)

  --line-color: rgba(0, 0, 0, 0.1) rgba(255, 255, 255, 0.1)
  --meta-divider: rgba(0, 0, 0, 0.2) rgba(255, 255, 255, 0.2)
  --content-meta: #858585 #a0a0a0

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: rgba(73, 177, 245, 0.3) rgba(73, 177, 245, 0.4)
  --codeblock-selection: var(--selection-bg)
  --codeblock-bg: #f6f8fa #1a1a2e
  --codeblock-topbar-bg: #e6ebf1 #141428

  --license-block-bg: rgba(0, 0, 0, 0.03) var(--codeblock-bg)

  --link-underline: rgba(73, 177, 245, 0.3) rgba(73, 177, 245, 0.4)
  --link-hover: rgba(73, 177, 245, 0.2) rgba(73, 177, 245, 0.3)
  --link-active: rgba(73, 177, 245, 0.15) rgba(73, 177, 245, 0.25)

  --float-panel-bg: #ffffff #1e1e38

  --scrollbar-bg-light: #49b1f5
  --scrollbar-bg-hover-light: #ff7242
  --scrollbar-bg-active-light: #ff8555

  --scrollbar-bg-dark: #5bc0ff
  --scrollbar-bg-hover-dark: #ff8555
  --scrollbar-bg-active-dark: #ff9666

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: #49b1f5 #5bc0ff
  --admonitions-color-note: #5b9cf5 #6baaf5
  --admonitions-color-important: #a855f7 #b966f8
  --admonitions-color-warning: #f59e0b #f6ad2b
  --admonitions-color-caution: #ff7242 #ff8555

  --toc-badge-bg: #e8f4fd #2a2a4a
  --toc-btn-hover: #f0f7fe #222244
  --toc-btn-active: #e0eef9 #282848
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #49b1f5 #5bc0ff
})

/* 非全屏壁纸模式下，--card-bg-transparent 应该和 --card-bg 一致（不透明） */
body:not(.wallpaper-transparent)
  --card-bg-transparent: var(--card-bg)

/* 全屏壁纸模式下，--card-bg-transparent 使用真正的半透明值 */
body.wallpaper-transparent
  --card-bg-transparent: rgba(255, 255, 255, 0.85)

:root.dark body.wallpaper-transparent
  --card-bg-transparent: rgba(30, 30, 56, 0.85)
