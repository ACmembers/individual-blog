---
import ButterflyLayout from "@layouts/ButterflyLayout.astro";
import ButterflyPostCard from "@components/features/posts/ButterflyPostCard.astro";
import { getSortedPosts } from "@utils/content-utils";
import { siteConfig } from "@/config";

const posts = await getSortedPosts();
---

<ButterflyLayout isHome={true} description={siteConfig.subtitle}>
  <div class="recent-posts" id="recent-posts">
    {posts.map(post => (
      <ButterflyPostCard post={post} />
    ))}
  </div>
</ButterflyLayout>
