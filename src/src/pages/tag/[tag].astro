---
import ButterflyLayout from "@layouts/ButterflyLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags || []) {
      if (tag) tagSet.add(tag);
    }
  }
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const base = import.meta.env.BASE_URL;
const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => (p.data.tags || []).includes(tag));
---

<ButterflyLayout
  title={`${tag} · ${siteConfig.title}`}
  description={`标签：${tag}`}
>
  <section class="py-4">
    <h1 class="text-2xl font-bold mb-6 text-neutral-900 dark:text-neutral-100">
      # {tag}
      <span class="text-base font-normal text-neutral-400 ml-2">{posts.length} 篇</span>
    </h1>

    {posts.length === 0 ? (
      <p class="text-neutral-400 dark:text-neutral-500 text-center py-12">暂无文章</p>
    ) : (
      <div class="flex flex-col gap-4">
        {posts.map((post) => (
          <a
            href={`${base}posts/${post.id}/`}
            class="block p-5 rounded-xl bg-white/85 dark:bg-neutral-900/85 backdrop-blur-sm shadow-sm hover:shadow-md transition-all border border-neutral-200/50 dark:border-neutral-700/50"
          >
            <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
              {post.data.title}
            </h2>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2">
              {formatDateToYYYYMMDD(post.data.published)}
              {post.data.category && (
                <span class="ml-2 text-[var(--primary)]">· {post.data.category}</span>
              )}
            </p>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    )}
  </section>
</ButterflyLayout>
