---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { siteConfig } from "../config";

const base = import.meta.env.BASE_URL;
const posts = await getSortedPosts();

const FIXED_CATEGORIES = ["408", "算法", "开发", "数学"] as const;

// Count posts per category
const postCounts: Record<string, number> = {};
for (const c of FIXED_CATEGORIES) postCounts[c] = 0;
for (const post of posts) {
  const cat = post.data.category || "";
  if (cat in postCounts) postCounts[cat]++;
}
const categories = FIXED_CATEGORIES.map((c) => [c, postCounts[c]] as const);
---

<MainGridLayout
  title={siteConfig.title}
  description={siteConfig.subtitle}
>
  <section class="category-grid py-4">
    {categories.map(([cat, count]) => (
      <a
        class="category-card block p-6 rounded-xl bg-white/85 dark:bg-neutral-900/85 backdrop-blur-sm shadow-md hover:shadow-lg transition-all hover:-translate-y-1 border border-neutral-200/50 dark:border-neutral-700/50"
        href={`${base}category/${encodeURIComponent(cat)}/`}
      >
        <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">{cat}</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">{count} 篇文章</p>
      </a>
    ))}
    {categories.length === 0 && (
      <p class="text-neutral-400 dark:text-neutral-500 text-center py-12 col-span-full">暂无分类</p>
    )}
  </section>
</MainGridLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
